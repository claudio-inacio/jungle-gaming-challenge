{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173 --strictPort",
      "url": ["http://localhost:4173/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.4 }],
        "categories:accessibility": ["error", { "minScore": 0.4 }],
        "categories:best-practices": ["error", { "minScore": 0.4 }],
        "categories:seo": ["error", { "minScore": 0.4 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "reports/lighthouse/desktop" }
  }
}
